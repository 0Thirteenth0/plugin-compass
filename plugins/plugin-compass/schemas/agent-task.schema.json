{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugin-compass.local/schemas/agent-task.schema.json",
  "title": "Plugin Compass Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task", "context", "selected_model", "supported_efforts", "support_evidence", "assessment", "acceptance_checks", "delegation_authorized", "delegation_worthwhile"],
  "properties": {
    "schema_version": {"const": "plugin-compass.agent-task.v1"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
    "task": {"type": "string", "minLength": 1, "maxLength": 16000},
    "context": {"type": "string", "minLength": 1, "maxLength": 16000},
    "selected_model": {"type": "string", "minLength": 1, "maxLength": 200},
    "supported_efforts": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}},
    "support_evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["complexity", "ambiguity", "risk", "validation_strength", "rationale"],
      "properties": {
        "complexity": {"enum": ["low", "medium", "high"]},
        "ambiguity": {"enum": ["low", "medium", "high"]},
        "risk": {"enum": ["low", "medium", "high"]},
        "validation_strength": {"enum": ["decisive", "partial", "none"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "acceptance_checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "delegation_authorized": {"type": "boolean"},
    "delegation_worthwhile": {"type": "boolean"},
    "previous_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_model", "reasoning_effort", "reasoning_retries", "failure_kind", "failed_evidence"],
      "properties": {
        "selected_model": {"type": "string", "minLength": 1, "maxLength": 200},
        "reasoning_effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "reasoning_retries": {"enum": [0, 1]},
        "failure_kind": {"enum": ["reasoning", "tool", "permission", "missing_input", "unknown"]},
        "failed_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    }
  }
}
