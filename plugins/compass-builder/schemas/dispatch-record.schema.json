{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/compass-builder/dispatch-record.schema.json",
  "title": "Compass Builder immutable rolling dispatch record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dispatchId", "runId", "storyId", "attempt", "planDigest", "workerStartSha", "prerequisites", "exactModel", "recommendedEffort", "writeScopes", "requiredOutcomeGateIds", "gateApprovalDigests", "handoffDigest", "registeredClone"],
  "properties": {
    "schemaVersion": {"const": "compass-builder.dispatch-record.v2"},
    "dispatchId": {"$ref": "#/$defs/id"},
    "runId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}-[0-9a-f]{16,64}$"},
    "storyId": {"$ref": "#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1},
    "planDigest": {"$ref": "#/$defs/digest"},
    "workerStartSha": {"$ref": "#/$defs/sha"},
    "prerequisites": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/prerequisite"}},
    "exactModel": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(?!inherit$)(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"},
    "recommendedEffort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    "writeScopes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "run-spec.v2.schema.json#/$defs/scope"}},
    "requiredOutcomeGateIds": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "gateApprovalDigests": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "handoffDigest": {"$ref": "#/$defs/digest"},
    "registeredClone": {"$ref": "#/$defs/registeredClone"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyId", "workerReceiptDigest", "integrationEvidenceDigest", "gateEvidenceDigests"],
      "properties": {
        "storyId": {"$ref": "#/$defs/id"},
        "workerReceiptDigest": {"$ref": "#/$defs/digest"},
        "integrationEvidenceDigest": {"$ref": "#/$defs/digest"},
        "gateEvidenceDigests": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    },
    "registeredClone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloneId", "repositoryRootDigest", "gitCommonDirDigest", "branch"],
      "properties": {
        "cloneId": {"$ref": "#/$defs/id"},
        "repositoryRootDigest": {"$ref": "#/$defs/digest"},
        "gitCommonDirDigest": {"$ref": "#/$defs/digest"},
        "branch": {"$ref": "run-spec.v2.schema.json#/$defs/branch"}
      }
    }
  }
}
