{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/compass-builder/plan-bundle.schema.json",
  "title": "Compass Builder execution plan bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runSpec", "wavePlan", "hostCapabilities", "planningTimestamp", "repositoryIdentity"],
  "properties": {
    "schemaVersion": {"const": "compass-builder.plan-bundle.v1"},
    "runSpec": {"$ref": "run-spec.schema.json"},
    "wavePlan": {"$ref": "wave-plan.schema.json"},
    "hostCapabilities": {"$ref": "host-capabilities.schema.json"},
    "planningTimestamp": {"type": "string", "format": "date-time", "maxLength": 64},
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRoot", "commonGitDir", "gitDir"],
      "properties": {
        "repositoryRoot": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"},
        "commonGitDir": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"},
        "gitDir": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"}
      }
    }
  }
}
