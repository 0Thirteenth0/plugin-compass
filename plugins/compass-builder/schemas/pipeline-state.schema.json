{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/compass-builder/pipeline-state.schema.json",
  "title": "Compass Builder durable rolling pipeline state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "planDigest", "baseSha", "integrationBranch", "initialIntegrationSha", "currentIntegrationSha", "lastVerifiedIntegrationSha", "previousState", "state", "lastEventSequence", "lastEventDigest", "activeOwners", "integrationQueue", "activeBlocker", "blockerHistory", "stories"],
  "properties": {
    "schemaVersion": {"const": "compass-builder.pipeline-state.v2"},
    "runId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}-[0-9a-f]{16,64}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "baseSha": {"$ref": "#/$defs/sha"},
    "integrationBranch": {"$ref": "run-spec.v2.schema.json#/$defs/branch"},
    "initialIntegrationSha": {"$ref": "#/$defs/sha"},
    "currentIntegrationSha": {"$ref": "#/$defs/sha"},
    "lastVerifiedIntegrationSha": {"$ref": "#/$defs/sha"},
    "previousState": {"anyOf": [{"$ref": "#/$defs/runState"}, {"type": "null"}]},
    "state": {"$ref": "#/$defs/runState"},
    "lastEventSequence": {"type": "integer", "minimum": 0},
    "lastEventDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "activeOwners": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/activeOwner"}},
    "integrationQueue": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "activeBlocker": {"anyOf": [{"$ref": "#/$defs/blocker"}, {"type": "null"}]},
    "blockerHistory": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/blocker"}},
    "stories": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/story"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runState": {"enum": ["planned", "running", "draining", "completed", "blocked"]},
    "lifecycle": {"enum": ["never-launched", "running", "process-unknown", "worker-complete-unverified", "verified-unimported", "imported-awaiting-integration", "merged-awaiting-post-check", "integration-verified", "blocked"]},
    "activeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyId", "ownerId", "writeScopes", "workerStartSha", "registeredCloneDigest"],
      "properties": {
        "storyId": {"$ref": "#/$defs/id"},
        "ownerId": {"$ref": "#/$defs/id"},
        "writeScopes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "run-spec.v2.schema.json#/$defs/scope"}},
        "workerStartSha": {"$ref": "#/$defs/sha"},
        "registeredCloneDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockerId", "eventId", "storyId", "phase", "reason", "evidenceDigest", "resumeState"],
      "properties": {
        "blockerId": {"$ref": "#/$defs/id"},
        "eventId": {"$ref": "#/$defs/id"},
        "storyId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "phase": {"enum": ["dispatch", "worker", "verification", "import", "merge", "post-check", "gate", "controller"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"},
        "evidenceDigest": {"$ref": "#/$defs/digest"},
        "resumeState": {"enum": ["planned", "running", "draining"]}
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyId", "integrationOrdinal", "lifecycle", "blockedFromLifecycle", "attempt", "workerStartSha", "branch", "registeredCloneDigest", "workerReceiptDigest", "verificationEvidenceDigest", "importEvidenceDigest", "mergeIntentDigest", "integrationSha", "postCheckEvidenceDigest", "gateEvidenceDigests"],
      "properties": {
        "storyId": {"$ref": "#/$defs/id"},
        "integrationOrdinal": {"type": "integer", "minimum": 1},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "blockedFromLifecycle": {"anyOf": [{"$ref": "#/$defs/lifecycle"}, {"type": "null"}]},
        "attempt": {"type": "integer", "minimum": 0},
        "workerStartSha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "branch": {"$ref": "run-spec.v2.schema.json#/$defs/branch"},
        "registeredCloneDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "workerReceiptDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "verificationEvidenceDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "importEvidenceDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "mergeIntentDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "integrationSha": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "postCheckEvidenceDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "gateEvidenceDigests": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
