{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/compass-builder/worker-output.schema.json",
  "title": "Compass Builder worker output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "summary", "acceptanceChecks", "blocker"],
  "properties": {
    "schemaVersion": {
      "type": "string", "const": "compass-builder.worker-output.v1"
    },
    "status": {
      "type": "string", "enum": ["succeeded", "failed", "blocked"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "acceptanceChecks": {
      "type": "array", "maxItems": 128,
      "items": {"$ref": "#/$defs/check"}
    },
    "blocker": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 4000}
      ]
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status", "evidence"],
      "properties": {
        "check": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {
          "type": "string", "enum": ["passed", "failed", "not-run"]
        },
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
