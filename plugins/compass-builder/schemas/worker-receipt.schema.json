{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openai.local/compass-builder/worker-receipt.schema.json",
  "title": "Compass Builder worker receipt v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "storyId", "branch", "worktree", "exactModel", "effort", "baseSha", "headSha", "commitSha", "changedFiles", "checks", "elapsedMs", "status", "blocker"],
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"headSha": {"$ref": "#/$defs/sha"}, "commitSha": {"$ref": "#/$defs/sha"}, "blocker": {"type": "null"}, "changedFiles": {"minItems": 1}, "checks": {"minItems": 1, "items": {"properties": {"status": {"const": "passed"}}}}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "blocked", "timed-out"]}}}, "then": {"properties": {"blocker": {"type": "string", "minLength": 1}}}}
  ],
  "properties": {
    "schemaVersion": {"const": "compass-builder.worker-receipt.v1"}, "runId": {"$ref": "#/$defs/runId"}, "storyId": {"$ref": "#/$defs/id"}, "branch": {"$ref": "#/$defs/branch"}, "worktree": {"$ref": "#/$defs/worktree"},
    "exactModel": {"allOf": [{"$ref": "#/$defs/model"}, {"not": {"const": "inherit"}}]}, "effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}, "baseSha": {"$ref": "#/$defs/sha"}, "headSha": {"$ref": "#/$defs/nullableSha"}, "commitSha": {"$ref": "#/$defs/nullableSha"},
    "changedFiles": {"type": "array", "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sourcePath", "changeType"], "allOf": [{"if": {"properties": {"changeType": {"const": "renamed"}}}, "then": {"properties": {"sourcePath": {"$ref": "#/$defs/scope"}}}, "else": {"properties": {"sourcePath": {"type": "null"}}}}], "properties": {"path": {"$ref": "#/$defs/scope"}, "sourcePath": {"anyOf": [{"$ref": "#/$defs/scope"}, {"type": "null"}]}, "changeType": {"enum": ["added", "modified", "deleted", "renamed"]}}}},
    "checks": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["name", "command", "status", "evidenceDigest"], "properties": {"name": {"$ref": "#/$defs/checkName"}, "command": {"$ref": "#/$defs/nonEmpty"}, "status": {"enum": ["passed", "failed", "blocked"]}, "evidenceDigest": {"$ref": "#/$defs/digest"}}}},
    "elapsedMs": {"type": "integer", "minimum": 1}, "status": {"enum": ["succeeded", "failed", "blocked", "timed-out"]}, "blocker": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}
  },
  "$defs": {"nonEmpty": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}, "checkName": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}, "worktree": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}, "model": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "nullableSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "runId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}-[0-9a-f]{16,64}$"}, "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "branch": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!@$)(?![-/])(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.[Ll][Oo][Cc][Kk](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*(?:\\.\\.|//|@\\{|\\\\|[\\u0000-\\u0020\\u007f~^:?*\\[\\]<>|]|\\s|\\x22))[^/]+(?:/[^/]+)*(?<![/. ])$"}, "scope": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f:<>|?*])(?!.*\\x22)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*$"}}
}
