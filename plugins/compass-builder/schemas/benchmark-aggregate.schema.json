{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/compass-builder/benchmark-aggregate.schema.json",
  "title": "Compass Builder benchmark aggregate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workloadManifest", "workloadManifestDigest", "workloadControls", "controlsDigest", "eventLedger", "attempts"],
  "properties": {
    "schemaVersion": {"const": "compass-builder.benchmark-aggregate.v1"},
    "workloadManifest": {"$ref": "benchmark-workloads.schema.json"},
    "workloadManifestDigest": {"$ref": "#/$defs/digest"},
    "workloadControls": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workloadId", "controls"],
        "properties": {
          "workloadId": {"$ref": "#/$defs/id"},
          "controls": {"$ref": "benchmark-receipt.schema.json#/$defs/controls"}
        }
      }
    },
    "controlsDigest": {"$ref": "#/$defs/digest"},
    "eventLedger": {"$ref": "#/$defs/eventLedger"},
    "attempts": {
      "type": "array", "minItems": 1, "maxItems": 16384,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workloadId", "attemptId", "arm", "pairNumber", "receiptDigest", "terminalStatus"],
        "properties": {
          "workloadId": {"$ref": "#/$defs/id"},
          "attemptId": {"$ref": "#/$defs/id"},
          "arm": {"enum": ["sequential", "parallel"]},
          "pairNumber": {"type": "integer", "minimum": 0},
          "receiptDigest": {"$ref": "#/$defs/digest"},
          "terminalStatus": {"enum": ["green", "failed", "timed-out", "blocked", "incomparable"]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "eventLedger": {
      "type": "object", "additionalProperties": false,
      "required": ["terminalHash", "firstSequence", "lastSequence"],
      "properties": {
        "terminalHash": {"$ref": "#/$defs/digest"},
        "firstSequence": {"type": "integer", "minimum": 1},
        "lastSequence": {"type": "integer", "minimum": 1}
      }
    }
  }
}
